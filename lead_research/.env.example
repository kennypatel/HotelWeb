# ── Anchor for Hotels — Lead Scraper Environment Config ──────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Run limits ────────────────────────────────────────────────────────────────
LEADS_LIMIT=100          # max leads to collect per run
REQUEST_DELAY=2.5        # polite delay (seconds) between all HTTP requests

# ── Output files ──────────────────────────────────────────────────────────────
OUTPUT_FILE=motel_hotel_leads.csv
NO_EMAIL_FILE=no_email_found.csv
LOG_FILE=lead_research.log

# ── Search API (choose ONE — tool falls back to free DuckDuckGo if none set) ──

# Option A: SerpAPI  →  https://serpapi.com  (recommended for production)
SERPAPI_KEY=

# Option B: Google Custom Search API  →  https://programmablesearchengine.google.com
# Requires a Custom Search Engine ID configured to search the entire web.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# ── Notes ─────────────────────────────────────────────────────────────────────
# - Leave all API keys blank to use the free DuckDuckGo backend.
# - SerpAPI: free tier = 100 searches/month; $50/mo for 5,000 searches.
# - Google CSE: 100 free queries/day; $5 per 1,000 queries after that.
# - Increase REQUEST_DELAY if you hit rate limits.
